USER root

# Install yarn
RUN npm install -g yarn

# Install system dependencies for happy-server (postgres/redis/minio run in docker-compose)
RUN apt-get update && apt-get install -y \
    postgresql-client \
    lsof \
    nmap \
    wget
#    && rm -rf /var/lib/apt/lists/*

# Install MinIO client (mc) for bucket management
RUN wget -q https://dl.min.io/client/mc/release/linux-amd64/mc \
    && chmod +x mc \
    && mv mc /usr/local/bin/

# Install Playwright for browser automation testing
RUN npm install -g playwright \
    && npx playwright install chromium \
    && npx playwright install-deps chromium

# Expose ports for Happy services
# happy-server API
EXPOSE 3005
# happy web client (Expo)
EXPOSE 8081
